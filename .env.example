# LLM & Embeddings (requires local Ollama running on http://localhost:11434)
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# Chunking
CHUNKER=paragraph
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Retrieval & Reranking
RETRIEVER=dense
RERANKER=keyword
TOP_K=5
TOP_N=2

# Vector Store ("memory", "sqlite", "chroma", "qdrant")
VECTOR_STORE=memory

# Logging ("DEBUG", "INFO", "WARNING")
LOG_LEVEL=INFO

